__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# 选型失败样本：404 页面、SPA 空壳、防盗链错误页，无参考价值，
# 且含第三方厂商网站 HTML 片段。失败原因记录在 docs/语料来源与选型说明.md
data/raw/_rejected/
data/md/_stale/

# M2 中间产物：key_point 规范化前的备份、冒烟测试残留
*.bak
data/eval/_smoke*
data/eval/*.errors.jsonl

# M2 中间产物：调试残留、规范化前的快照、改写失败明细
data/eval/_debug_*.txt
data/eval/*.bak127
data/eval/rewrite_errors.jsonl

# 一致性验证的临时目录（抽原始文件重跑抽取，比对 md 是否逐字一致）
_tmp/

# gzip 解压的一次性中间件：data/raw 里存的是**下载到的原始 gzip 字节**，
# html_to_md.py 已内置 maybe_gunzip()，重跑抽取结果逐字一致（已验），
# 所以这份解压副本不必入库。
data/raw/_recompress/
